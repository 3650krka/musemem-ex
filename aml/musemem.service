[Unit]
Description=musemem-ex AML memory service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/musemem-ex
EnvironmentFile=/etc/musemem/env
ExecStart=/usr/bin/node --experimental-strip-types aml/server.ts
Restart=always
RestartSec=3
StandardOutput=append:/home/ubuntu/musemem-ex/server.log
StandardError=append:/home/ubuntu/musemem-ex/server.log

[Install]
WantedBy=multi-user.target
